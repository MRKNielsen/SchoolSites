# Normalise line endings so a file edited on Windows doesn't show up as a
# whole-file diff. Everything git detects as text is stored LF in the repo;
# checkout is left to core.autocrlf, so Windows editors still behave.
#
# Six files were carrying pure CRLF-vs-LF noise before this landed —
# 2,282 lines of phantom diff across site.css, two index pages, an audit
# note, questions.js and rubric.html.
#
# After changing this file, renormalise once:
#     git add --renormalize .

* text=auto eol=lf

# Binary — never touch these.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.eot   binary
*.zip   binary

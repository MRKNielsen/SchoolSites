# LaTeX build clutter
*.aux
*.log
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz
*.nav
*.snm

# OS / editor
.DS_Store
Thumbs.db
*.swp

# Node tooling — symlinks in node_modules/.bin break git on this
# filesystem ("Function not implemented"). Never commit it.
node_modules/
package.json
package-lock.json

# Never commit student data
*students*.csv
*rooming*.csv

# Plaintext behind the staff-password gate. Gated pages ship an encrypted
# blob; the payload they were built from must never be committed or the
# lock is pointless. Round-trip them through tools/staff-crypt.html.
*-payload.html
year10-mathematics/10methods-primer/Ch7_QuadraticFunctions_TeachingNotes.docx

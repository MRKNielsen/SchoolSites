# LaTeX build clutter
*.aux
*.log
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz
*.synctex
*.synctex(busy)
*.nav
*.snm

# OS / editor
.DS_Store
Thumbs.db
*.swp

# Node tooling — symlinks in node_modules/.bin break git on this
# filesystem ("Function not implemented"). Never commit it.
node_modules/
package.json
package-lock.json

# Python bytecode from the tools/ build scripts. Two .pyc files were
# committed on 21 Oct 2026; drop them from the index with
#   git rm -r --cached tools/__pycache__
__pycache__/
*.pyc

# Never commit student data
*students*.csv
*rooming*.csv

# Plaintext behind the staff-password gate. Gated pages ship an encrypted
# blob; the payload they were built from must never be committed or the
# lock is pointless. Round-trip them through tools/staff-crypt.html.
*-payload.html
year10-mathematics/10methods-primer/Ch7_QuadraticFunctions_TeachingNotes.docx
year12-algorithmics/unit-4/sat/Memo03_brief.pdf

# Teacher copy of the Ch3G-L worked example set: the wrapper holds every
# answer and builds the red-filled PDF. Staff material -- never commit.
year10-mathematics/10methods-primer/booklet/Ch3G-L_Example_Set_Teacher.tex
year10-mathematics/10methods-primer/booklet/Ch3G-L_Example_Set_Teacher.pdf

# Teacher copy of the Trebuchet Investigation (Forces): the wrapper holds
# every answer and builds the red-filled PDF. Staff material -- never commit.
year7-science/forces/booklet/Trebuchet_Investigation_Yr7_8_Teacher.tex
year7-science/forces/booklet/Trebuchet_Investigation_Yr7_8_Teacher.pdf
